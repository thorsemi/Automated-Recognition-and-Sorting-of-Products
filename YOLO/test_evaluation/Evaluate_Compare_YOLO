# ================== HJÆLPEFUNKTIONER ================== #


def yolo_to_xyxy(
    x_center: float,
    y_center: float,
    width: float,
    height: float,
    img_w: int,
    img_h: int,
) -> Tuple[float, float, float, float]:
    """Konverterer YOLO (relativt) til absolut (x1, y1, x2, y2)."""
    w_abs = width * img_w
    h_abs = height * img_h
    x_abs = x_center * img_w
    y_abs = y_center * img_h

    x1 = x_abs - w_abs / 2.0
    y1 = y_abs - h_abs / 2.0
    x2 = x_abs + w_abs / 2.0
    y2 = y_abs + h_abs / 2.0

    return x1, y1, x2, y2


def load_ground_truths(
    images_dir: Path,
    labels_dir: Path,
) -> Dict[str, np.ndarray]:
    """
    Loader ground-truth bokse i YOLO-format og konverterer til:
    [cls, x1, y1, x2, y2] pr. boks.
    Returnerer dict: {image_stem: array(N, 5)}.
    """
    gt_by_image: Dict[str, List[List[float]]] = {}

    image_paths = sorted(
        list(images_dir.glob("*.png"))
        + list(images_dir.glob("*.jpg"))
        + list(images_dir.glob("*.jpeg"))
    )

    for img_path in image_paths:
        stem = img_path.stem
        label_path = labels_dir / f"{stem}.txt"
        if not label_path.exists():
            continue

        img = plt.imread(img_path)
        if img.ndim == 3:
            img_h, img_w, _ = img.shape
        else:
            img_h, img_w = img.shape

        boxes: List[List[float]] = []
        with label_path.open("r", encoding="utf-8") as f:
            for line in f:
                parts = line.strip().split()
                if len(parts) != 5:
                    continue
                cls_id = int(float(parts[0]))
                x_c = float(parts[1])
                y_c = float(parts[2])
                w = float(parts[3])
                h = float(parts[4])

                x1, y1, x2, y2 = yolo_to_xyxy(x_c, y_c, w, h, img_w, img_h)
                boxes.append([cls_id, x1, y1, x2, y2])

        if boxes:
            gt_by_image[stem] = np.array(boxes, dtype=float)

    return gt_by_image


def compute_iou_matrix(
    boxes_pred: np.ndarray,
    boxes_gt: np.ndarray,
) -> np.ndarray:
    """IoU mellem alle pred- og gt-bokse."""
    if boxes_pred.size == 0 or boxes_gt.size == 0:
        return np.zeros((boxes_pred.shape[0], boxes_gt.shape[0]))

    x1_pred = boxes_pred[:, 0][:, None]
    y1_pred = boxes_pred[:, 1][:, None]
    x2_pred = boxes_pred[:, 2][:, None]
    y2_pred = boxes_pred[:, 3][:, None]

    x1_gt = boxes_gt[:, 0][None, :]
    y1_gt = boxes_gt[:, 1][None, :]
    x2_gt = boxes_gt[:, 2][None, :]
    y2_gt = boxes_gt[:, 3][None, :]

    inter_x1 = np.maximum(x1_pred, x1_gt)
    inter_y1 = np.maximum(y1_pred, y1_gt)
    inter_x2 = np.minimum(x2_pred, x2_gt)
    inter_y2 = np.minimum(y2_pred, y2_gt)

    inter_w = np.clip(inter_x2 - inter_x1, a_min=0.0, a_max=None)
    inter_h = np.clip(inter_y2 - inter_y1, a_min=0.0, a_max=None)
    inter_area = inter_w * inter_h

    area_pred = (x2_pred - x1_pred) * (y2_pred - y1_pred)
    area_gt = (x2_gt - x1_gt) * (y2_gt - y1_gt)

    union_area = area_pred + area_gt - inter_area + 1e-8
    iou = inter_area / union_area
    return iou


def match_detections(
    gt_boxes: np.ndarray,
    pred_boxes: np.ndarray,
    iou_threshold: float,
) -> int:
    """Greedy matching: returnerer antal TP."""
    if gt_boxes.size == 0 or pred_boxes.size == 0:
        return 0

    iou = compute_iou_matrix(pred_boxes, gt_boxes)
    n_gt = gt_boxes.shape[0]
    used_gt = np.zeros(n_gt, dtype=bool)
    true_positives = 0

    for i in range(iou.shape[0]):
        j_best = int(np.argmax(iou[i]))
        if iou[i, j_best] >= iou_threshold and not used_gt[j_best]:
            used_gt[j_best] = True
            true_positives += 1

    return true_positives


def run_inference_on_val(
    model: YOLO,
    images_dir: Path,
    conf_base: float = 0.05,
) -> Dict[str, np.ndarray]:
    """
    Kører modellen på alle val-billeder.
    Returnerer dict: {image_stem: array(N, 6)}
    med [cls, conf, x1, y1, x2, y2].
    """
    preds_by_image: Dict[str, np.ndarray] = {}

    image_paths = sorted(
        list(images_dir.glob("*.png"))
        + list(images_dir.glob("*.jpg"))
        + list(images_dir.glob("*.jpeg"))
    )

    for img_path in image_paths:
        stem = img_path.stem
        results = model(
            source=str(img_path),
            conf=conf_base,
            iou=IOU_THRESHOLD,
            verbose=False,
        )[0]

        if results.boxes is None or len(results.boxes) == 0:
            preds_by_image[stem] = np.zeros((0, 6), dtype=float)
            continue

        cls = results.boxes.cls.cpu().numpy().astype(int)
        conf = results.boxes.conf.cpu().numpy()
        xyxy = results.boxes.xyxy.cpu().numpy()

        data = np.concatenate(
            [
                cls[:, None].astype(float),
                conf[:, None],
                xyxy.astype(float),
            ],
            axis=1,
        )
        preds_by_image[stem] = data

    return preds_by_image


def evaluate_predictions(
    preds_by_image: Dict[str, np.ndarray],
    gt_by_image: Dict[str, np.ndarray],
    num_classes: int,
    conf_threshold: float,
    iou_threshold: float,
) -> Tuple[float, float, float]:
    """Micro-averaged precision, recall og F1."""
    tp_per_class = np.zeros(num_classes, dtype=float)
    fp_per_class = np.zeros(num_classes, dtype=float)
    fn_per_class = np.zeros(num_classes, dtype=float)

    for stem, gt_boxes_full in gt_by_image.items():
        preds_full = preds_by_image.get(stem, np.zeros((0, 6), dtype=float))

        gt_cls = gt_boxes_full[:, 0].astype(int)
        gt_xyxy = gt_boxes_full[:, 1:5]

        if preds_full.size == 0:
            for cls_id in gt_cls:
                fn_per_class[cls_id] += 1
            continue

        mask_conf = preds_full[:, 1] >= conf_threshold
        preds_conf = preds_full[mask_conf]

        if preds_conf.size == 0:
            for cls_id in gt_cls:
                fn_per_class[cls_id] += 1
            continue

        for cls_id in range(num_classes):
            gt_mask = gt_cls == cls_id
            gt_boxes = gt_xyxy[gt_mask]

            pred_mask = preds_conf[:, 0].astype(int) == cls_id
            pred_boxes_all = preds_conf[pred_mask]

            if gt_boxes.size == 0 and pred_boxes_all.size == 0:
                continue

            if gt_boxes.size == 0 and pred_boxes_all.size > 0:
                fp_per_class[cls_id] += pred_boxes_all.shape[0]
                continue

            if gt_boxes.size > 0 and pred_boxes_all.size == 0:
                fn_per_class[cls_id] += gt_boxes.shape[0]
                continue

            order = np.argsort(-pred_boxes_all[:, 1])
            pred_boxes_sorted = pred_boxes_all[order][:, 2:6]

            tp = match_detections(
                gt_boxes=gt_boxes,
                pred_boxes=pred_boxes_sorted,
                iou_threshold=iou_threshold,
            )

            fp = pred_boxes_sorted.shape[0] - tp
            fn = gt_boxes.shape[0] - tp

            tp_per_class[cls_id] += tp
            fp_per_class[cls_id] += fp
            fn_per_class[cls_id] += fn

    tp_total = tp_per_class.sum()
    fp_total = fp_per_class.sum()
    fn_total = fn_per_class.sum()

    precision = tp_total / (tp_total + fp_total + 1e-8)
    recall = tp_total / (tp_total + fn_total + 1e-8)
    f1 = (2.0 * precision * recall) / (precision + recall + 1e-8)

    return precision, recall, f1


def build_confusion_matrix(
    preds_by_image: Dict[str, np.ndarray],
    gt_by_image: Dict[str, np.ndarray],
    num_classes: int,
    conf_threshold: float,
    iou_threshold: float,
) -> np.ndarray:
    """
    Confusion matrix (gt vs. pred) med ekstra kolonne for 'background'.
    Matrix: (num_classes, num_classes + 1).
    """
    matrix = np.zeros((num_classes, num_classes + 1), dtype=int)

    for stem, gt_boxes_full in gt_by_image.items():
        preds_full = preds_by_image.get(stem, np.zeros((0, 6), dtype=float))

        gt_cls = gt_boxes_full[:, 0].astype(int)
        gt_xyxy = gt_boxes_full[:, 1:5]

        mask_conf = preds_full[:, 1] >= conf_threshold
        preds_conf = preds_full[mask_conf]

        pred_cls = preds_conf[:, 0].astype(int) if preds_conf.size > 0 else np.array([])
        pred_xyxy = preds_conf[:, 2:6] if preds_conf.size > 0 else np.zeros((0, 4))

        used_pred = np.zeros(pred_xyxy.shape[0], dtype=bool)

        for i, gt_box in enumerate(gt_xyxy):
            cls_gt = gt_cls[i]

            if pred_xyxy.size == 0:
                matrix[cls_gt, -1] += 1
                continue

            ious = compute_iou_matrix(
                boxes_pred=pred_xyxy,
                boxes_gt=gt_box[None, :],
            )[:, 0]

            best_idx = int(np.argmax(ious))
            best_iou = ious[best_idx]

            if best_iou >= iou_threshold and not used_pred[best_idx]:
                cls_pred = pred_cls[best_idx]
                matrix[cls_gt, cls_pred] += 1
                used_pred[best_idx] = True
            else:
                matrix[cls_gt, -1] += 1

    return matrix


# ================== PLOTS ================== #


def plot_precision_vs_conf(
    metrics_per_model: Dict[str, Dict[str, List[float]]],
) -> None:
    """Separate figur: Precision vs. confidence."""
    plt.figure(figsize=(8, 5))
    for model_name, metrics in metrics_per_model.items():
        plt.plot(
            metrics["conf"],
            metrics["precision"],
            linewidth=2,
            label=model_name,
            color=COLOR_MAP[model_name],
        )

    plt.xlabel("Confidence threshold")
    plt.ylabel("Precision")
    plt.ylim(0.0, 1.02)
    plt.title("Precision vs. confidence")
    plt.legend(frameon=True)
    plt.tight_layout()
    plt.show()



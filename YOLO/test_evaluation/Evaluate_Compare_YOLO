def plot_roc_curves(
    metrics_per_model: Dict[str, Dict[str, List[float]]],
) -> None:
    """
    ROC-lignende kurver for hver model.
    TPR ≈ recall, 'FPR' ≈ 1 - precision.
    Én separat figur pr. model, samme blå tema.
    """
    for model_name, metrics in metrics_per_model.items():
        tpr = np.array(metrics["recall"])
        fpr = 1.0 - np.array(metrics["precision"])

        plt.figure(figsize=(5, 5))
        plt.plot(
            fpr,
            tpr,
            linewidth=2,
            color=COLOR_MAP[model_name],
        )
        plt.plot([0, 1], [0, 1], linestyle="--", linewidth=1, color="#bbbbbb")

        plt.xlabel("False positive rate")
        plt.ylabel("True positive rate")
        plt.xlim(0.0, 1.0)
        plt.ylim(0.0, 1.0)
        plt.title(f"ROC curve (approx.) – {model_name}")
        plt.tight_layout()
        plt.show()


def plot_confusion_matrix_small(
    matrix: np.ndarray,
    class_names: List[str],
) -> None:
    """Confusion matrix for Small-modellen i blå/hvid stil."""
    num_classes = len(class_names)
    x_labels = class_names + ["background"]
    y_labels = class_names

    plt.figure(figsize=(8, 6))
    im = plt.imshow(matrix, interpolation="nearest", cmap="Blues")
    cbar = plt.colorbar(im, fraction=0.046, pad=0.04)
    cbar.ax.set_ylabel("Count")

    plt.xticks(np.arange(num_classes + 1), x_labels, rotation=45, ha="right")
    plt.yticks(np.arange(num_classes), y_labels)

    for i in range(num_classes):
        for j in range(num_classes + 1):
            value = int(matrix[i, j])
            if value == 0:
                continue
            plt.text(
                j,
                i,
                str(value),
                ha="center",
                va="center",
                fontsize=8,
                color="black",
            )

    plt.title("Confusion Matrix – Small", fontsize=14)
    plt.xlabel("Predicted class", fontsize=12)
    plt.ylabel("True class", fontsize=12)
    plt.tight_layout()
    plt.show()


# ================== MAIN ================== #


def main() -> None:
    print("=== YOLO metrics vs. confidence + ROC + Confusion (Small) ===")

    # Ground truth
    print("Indlæser ground truth...")
    gt_by_image = load_ground_truths(IMAGES_DIR, LABELS_DIR)
    if not gt_by_image:
        raise RuntimeError(
            "Ingen ground truth labels fundet. Tjek IMAGES_DIR og LABELS_DIR."
        )

    # Modeller
    print("Indlæser modeller...")
    models_loaded: Dict[str, YOLO] = {name: YOLO(path) for name, path in MODELS.items()}

    any_model = next(iter(models_loaded.values()))
    num_classes = len(any_model.names)
    class_names = [any_model.names[i] for i in range(num_classes)]

    # Inference + metrics
    metrics_per_model: Dict[str, Dict[str, List[float]]] = {}
    preds_small: Dict[str, np.ndarray] | None = None

    for model_name, model in models_loaded.items():
        print(f"Kører inference for {model_name}...")
        preds_by_image = run_inference_on_val(
            model=model,
            images_dir=IMAGES_DIR,
            conf_base=0.05,
        )

        if model_name == "Small":
            preds_small = preds_by_image

        precisions: List[float] = []
        recalls: List[float] = []
        f1s: List[float] = []

        print(f"Evaluerer {model_name}...")
        for conf in CONF_THRESHOLDS:
            p, r, f1 = evaluate_predictions(
                preds_by_image=preds_by_image,
                gt_by_image=gt_by_image,
                num_classes=num_classes,
                conf_threshold=float(conf),
                iou_threshold=IOU_THRESHOLD,
            )
            precisions.append(p)
            recalls.append(r)
            f1s.append(f1)

        metrics_per_model[model_name] = {
            "conf": list(CONF_THRESHOLDS),
            "precision": precisions,
            "recall": recalls,
            "f1": f1s,
        }

    # Separate figurer for PRF
    plot_precision_vs_conf(metrics_per_model)
    plot_recall_vs_conf(metrics_per_model)
    plot_f1_vs_conf(metrics_per_model)

    # ROC-lignende kurver (én figur pr. model)
    plot_roc_curves(metrics_per_model)

    # Confusion matrix for Small ved OPERATING_CONF
    if preds_small is not None:
        print("Bygger confusion matrix for Small...")
        cm_small = build_confusion_matrix(
            preds_by_image=preds_small,
            gt_by_image=gt_by_image,
            num_classes=num_classes,
            conf_threshold=OPERATING_CONF,
            iou_threshold=IOU_THRESHOLD,
        )
        plot_confusion_matrix_small(cm_small, class_names)

    print("=== Færdig ===")


if __name__ == "__main__":
    main()

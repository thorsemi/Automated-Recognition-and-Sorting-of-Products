# main_video.py
from pathlib import Path
import cv2
import numpy as np

from detection import detect_leaflets, make_binary_mask
from classification import classify_front_back

# >>> RET DENNE TIL DIN VIDEO <<<
VIDEO_PATH = r"C:\Users\emilt\Desktop\Materiale_Final_Vieo\5 (Med i Video).avi"

SHOW_WINDOW = True    # Vis resultat i et vindue
SHOW_MASK = False     # Sæt True for også at se global binær maske

# Alt over denne værdi betragtes som overlap (hvis ikke allerede fanget som overlap i detection)
AREA_OVERLAP_THRESHOLD = 16000.0


def main() -> None:
    video_path = Path(VIDEO_PATH)
    cap = cv2.VideoCapture(str(video_path))

    if not cap.isOpened():
        raise RuntimeError(f"Kunne ikke åbne video: {VIDEO_PATH}")

    # --- Info til outputvideo ---
    fps = cap.get(cv2.CAP_PROP_FPS)
    if fps <= 0:
        fps = 30.0  # fallback

    width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
    height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
    frame_size = (width, height)

    out_path = video_path.with_name(video_path.stem + "_processed.mp4")
    fourcc = cv2.VideoWriter_fourcc(*"mp4v")
    writer = cv2.VideoWriter(str(out_path), fourcc, fps, frame_size)

    if not writer.isOpened():
        cap.release()
        raise RuntimeError(f"Kunne ikke åbne VideoWriter til: {out_path}")

    print(f"▶️  Læser:  {VIDEO_PATH}")
    print(f"💾 Skriver: {out_path}")
    print(f"   FPS={fps:.2f}, size={width}x{height}")

    frame_idx = 0
    delay = max(int(1000 / fps), 1)

    while True:
        ok, frame_bgr = cap.read()
        if not ok:
            break  # slut på video

        frame_idx += 1

        # --- Gråskala + global binær maske ---
        frame_gray, binary_mask = make_binary_mask(frame_bgr)

        # --- Detektion (geometri + overlap) på gråbilledet ---
        (
            boxes,
            rects,
            mask_det,
            valid_contours,
            overlap_contours,
        ) = detect_leaflets(frame_gray)

        # VIGTIGT: single_areas = ALLE gyldige enkelt-sedler (uden area-filter)
        single_areas = [cv2.contourArea(c) for c in valid_contours]
        median_single_area = float(np.median(single_areas)) if single_areas else None

        outlined = cv2.cvtColor(frame_gray, cv2.COLOR_GRAY2BGR)

        # --- Enkelt-leaflets + front/back + ekstra area-overlap ---
        for idx, (box, rect, num_corners) in enumerate(boxes):
            cnt = valid_contours[idx]
            area = cv2.contourArea(cnt)

            # Hvis area er for stort → behandles som overlap (fallback),
            # men kun fordi detection IKKE har fanget den som overlap.
            if area > AREA_OVERLAP_THRESHOLD:
                cv2.drawContours(outlined, [box], 0, (0, 0, 255), 3)

                if median_single_area and median_single_area > 0:
                    ratio_n = area / median_single_area
                    line1 = f"OVERLAP x{ratio_n:.1f}"
                    if ratio_n > 2.3:
                        line2 = "HEAVY (3+ overlap)"
                    else:
                        line2 = "2_overlap"
                else:
                    line1 = "OVERLAP"
                    line2 = ""

                x, y, w, h = cv2.boundingRect(cnt)

                cv2.putText(
                    outlined,
                    line1,
                    (x, max(15, y - 10)),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (0, 0, 255),
                    2,
                )
                if line2:
                    cv2.putText(
                        outlined,
                        line2,
                        (x, max(30, y + 15)),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.6,
                        (0, 0, 255),
                        2,
                    )

                cv2.putText(
                    outlined,
                    f"A={area:.0f} [area>{int(AREA_OVERLAP_THRESHOLD)}]",
                    (x, y + h + 20),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.5,
                    (0, 0, 255),
                    2,
                )

                # Ingen Front/Back for disse
                continue

            # Normal enkelt-seddel (under threshold og ikke i overlap_contours)
            cv2.drawContours(outlined, [box], 0, (0, 255, 0), 2)

            label, ratio = classify_front_back(frame_gray, box)
            cx, cy = rect[0]

            text1 = f"{label} ({ratio:.2f})"
            text2 = f"A={area:.0f}"

            cv2.putText(
                outlined,
                text1,
                (int(cx), int(cy) - 15),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (255, 0, 0),   # blå
                2,
            )
            cv2.putText(
                outlined,
                text2,
                (int(cx), int(cy) + 10),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 255, 0),
                2,
            )

        # --- Overlap-kandidater fra detection (avanceret overlap-logik) ---
        for cnt, num_corners, reason in overlap_contours:
            rect = cv2.minAreaRect(cnt)
            box2 = cv2.boxPoints(rect).astype(int)
            cv2.drawContours(outlined, [box2], 0, (0, 0, 255), 3)

            area = cv2.contourArea(cnt)

            if median_single_area and median_single_area > 0:
                ratio_n = area / median_single_area
                line1 = f"OVERLAP x{ratio_n:.1f}"

                if ratio_n > 2.3:
                    line2 = "HEAVY (3+ overlap)"
                else:
                    line2 = "2_overlap"
            else:
                line1 = "OVERLAP"
                line2 = ""

            x, y, w, h = cv2.boundingRect(cnt)

            cv2.putText(
                outlined,
                line1,
                (x, max(15, y - 10)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.6,
                (0, 0, 255),
                2,
            )

            if line2:
                cv2.putText(
                    outlined,
                    line2,
                    (x, max(30, y + 15)),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (0, 0, 255),
                    2,
                )

            cv2.putText(
                outlined,
                f"A={area:.0f} [{reason}]",
                (x, y + h + 20),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.5,
                (0, 0, 255),
                2,
            )

        # --- Skriv frame til outputvideo ---
        writer.write(outlined)

        # --- Vis live (valgfrit) ---
        if SHOW_WINDOW:
            cv2.imshow("Processed", outlined)
            if SHOW_MASK:
                cv2.imshow("Global binary mask", binary_mask)

            key = cv2.waitKey(delay) & 0xFF
            if key == ord("q") or key == 27:
                break

        if frame_idx % 100 == 0:
            print(f"... {frame_idx} frames behandlet")

    cap.release()
    writer.release()
    cv2.destroyAllWindows()
    print("✅ Færdig med video. Gemte:", out_path)


if __name__ == "__main__":
    main()
